# Keep the build context small: only Go sources, vendor/, ui/dist and pairs.json
# are needed (see Dockerfile).
.git
.github
.claude
.idea
.vscode
**/.DS_Store

# Local state and build output
bin/
dist/
ninjabot.db*
backtest.db
*.out
coverage.html
**/__debug_bin*
.env
.env.*

# UI sources: the image only embeds the host-built ui/dist
ui/*
!ui/ui.go
!ui/dist

# Not needed to build the server
docs/
examples/
testdata/
**/*_test.go
*.md
